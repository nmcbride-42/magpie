# Copy to .env and load it into your shell before running:
#   set -a; . ./.env; set +a
# magpie reads the process environment; it does not parse .env itself.
# Every variable is optional.

# Where the sweep DB, MAST bulk scripts, FITS cache, plots, dossiers and
# packets are written. Default: ./data next to the package.
MAGPIE_DATA_DIR=./data

# SQLite database path. Default: $MAGPIE_DATA_DIR/magpie.db
# MAGPIE_DB=./data/magpie.db

# Parallel sweep shards used by `magpie.hunt`. Default: 4
MAGPIE_SHARDS=4

# Tier-3 text judge: a command that reads the prompt on stdin and prints a
# JSON array on stdout. Default uses the Claude Code CLI in print mode.
MAGPIE_JUDGE_CMD="claude -p"
# Optional model name, appended as `--model <name>` to the text judge.
# MAGPIE_JUDGE_MODEL=

# Tier-3.5 vision judge: same contract, but it must be able to open the PNG
# paths named in the prompt. Default: Claude Code CLI with only the Read tool.
MAGPIE_VISION_JUDGE_CMD="claude -p --allowedTools Read"

# User-Agent for catalog HTTP requests (ExoFOP, SIMBAD, VSX).
MAGPIE_USER_AGENT=magpie/0.1

# Name printed in the Discoverer field of VSX submission packets.
MAGPIE_DISCOVERER="Your Name"

# Set to 1 to run the archive-download validation tests.
# MAGPIE_NETWORK_TESTS=1
